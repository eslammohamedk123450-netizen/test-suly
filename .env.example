# Copy to .env locally; never commit .env or real values.
# SQLite is for local development only.
DATABASE_URL=sqlite:///./suly_ai.db
DATABASE_ECHO=false
# Production backend only; obtain the connection string from Supabase Database settings.
# Keep it in the hosting provider's secret manager, never in Flutter or GitHub.
# DATABASE_URL=postgresql+psycopg://postgres:<DB_PASSWORD>@<DB_HOST>:5432/postgres?sslmode=require
SECRET_KEY=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5000","http://localhost:8080"]
