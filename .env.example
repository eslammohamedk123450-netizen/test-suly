# Required for real AI responses; keep this key server-side only.
GEMINI_API_KEY=

# Optional Gemini model ID overrides.
GEMINI_MODEL=gemini-2.5-flash
SULY_PRO_MODEL=gemini-2.5-pro
SULY_REASONING_MODEL=gemini-2.5-pro
SULY_FAST_MODEL=gemini-2.5-flash
SULY_STEM_MODEL=gemini-2.5-flash

# Optional local server port.
PORT=3000
