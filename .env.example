# Copy to .env locally; never commit .env or real values.
DATABASE_URL=sqlite:///./suly_ai.db
DATABASE_ECHO=false
SECRET_KEY=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5000","http://localhost:8080"]
